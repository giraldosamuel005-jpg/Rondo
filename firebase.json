{
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "rondo-fb405",
          "appId": "1:948956367344:android:1d44d9bc47f6e36cf6f535",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "rondo-fb405",
          "configurations": {
            "android": "1:948956367344:android:1d44d9bc47f6e36cf6f535"
          }
        }
      }
    }
  },
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "public": "ficha_web",
    "rewrites": [
      { "source": "/f/**", "destination": "/index.html" }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Content-Security-Policy",
            "value": "default-src 'none'; script-src 'self'; style-src 'self'; connect-src https://firestore.googleapis.com; img-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
          },
          { "key": "Referrer-Policy", "value": "no-referrer" },
          { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
          { "key": "X-Content-Type-Options", "value": "nosniff" }
        ]
      },
      {
        "source": "/f/**",
        "headers": [
          { "key": "Cache-Control", "value": "no-store" }
        ]
      }
    ]
  }
}
